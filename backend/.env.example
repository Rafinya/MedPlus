APP_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=medplus_pos
DB_SSLMODE=disable
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/medplus_pos?sslmode=disable
